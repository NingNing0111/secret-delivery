# Copy to .env.local; supply your own values. Never commit populated credentials.
DATABASE_URL=postgresql://CHANGE_USER:CHANGE_PASSWORD@localhost:5432/secret_delivery
ADMIN_PASSWORD=
SESSION_SECRET=
# Canonical Base64 encoding of exactly 32 random bytes
SECRET_ENCRYPTION_KEY=
PUBLIC_BASE_URL=https://secrets.example.com
REQUEST_BODY_LIMIT=16777216
# Compose: use a separately generated hex password; no default credential
POSTGRES_PASSWORD=
SITE_ADDRESS=secrets.example.com
# Only explicit loopback HTTP development; never needed for HTTPS production
ALLOW_INSECURE_LOCAL_COOKIE=false
# Tests ONLY: dedicated local synthetic database; never use production URL
TEST_DATABASE_URL=postgresql://test:test@127.0.0.1:55432/secret_delivery_test
